# Docker network shared with the ZeitPlan Nginx gateway.
PUBLIC_PROXY_NETWORK=public-proxy

# The only hostname accepted by SillyTavern.
SILLYTAVERN_HOSTNAME=chat.markima.de

# Application-level protection. Use a long, unique password.
SILLYTAVERN_BASIC_AUTH_USERNAME=markima
SILLYTAVERN_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password

# UID/GID that own files in the persistent Docker volumes on the server.
PUID=1000
PGID=1000
